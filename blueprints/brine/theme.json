{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                {
                    "color": "#F5F0E6",
                    "name": "Background",
                    "slug": "background"
                },
                {
                    "color": "#1E1A17",
                    "name": "Foreground",
                    "slug": "foreground"
                },
                {
                    "color": "#375145",
                    "name": "Herb",
                    "slug": "herb"
                },
                {
                    "color": "#DCE3D4",
                    "name": "Ferment",
                    "slug": "ferment"
                },
                {
                    "color": "#1F241D",
                    "name": "Ferment Ink",
                    "slug": "ferment-ink"
                },
                {
                    "color": "#262B24",
                    "name": "Cellar",
                    "slug": "cellar"
                },
                {
                    "color": "#A4AF9C",
                    "name": "Sage Edge",
                    "slug": "sage-edge"
                },
                {
                    "color": "#F9F6EF",
                    "name": "Paper",
                    "slug": "paper"
                },
                {
                    "color": "#F5F0E6",
                    "name": "Surface 1",
                    "slug": "theme-1"
                },
                {
                    "color": "#F9F6EF",
                    "name": "Surface 2",
                    "slug": "theme-2"
                },
                {
                    "color": "#A4AF9C",
                    "name": "Surface 3",
                    "slug": "theme-3"
                },
                {
                    "color": "#1E1A17",
                    "name": "Surface 4",
                    "slug": "theme-4"
                },
                {
                    "color": "#262B24",
                    "name": "Surface 5",
                    "slug": "theme-5"
                }
            ]
        },
        "custom": {
            "spacing-increment": "2.5",
            "spacing-unit": "14"
        },
        "layout": {
            "contentSize": "720px",
            "wideSize": "1380px"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingScale": {
                "steps": 1
            },
            "spacingSizes": [
                {
                    "name": "2X-Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 1) * 1px), calc(var(--wp--custom--spacing-increment) * 1 * 2vw))",
                    "slug": "20"
                },
                {
                    "name": "X-Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 2) * 1px), calc(var(--wp--custom--spacing-increment) * 2 * 1vw))",
                    "slug": "30"
                },
                {
                    "name": "Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 3) * 1px), calc(var(--wp--custom--spacing-increment) * 3 * 1vw))",
                    "slug": "40"
                },
                {
                    "name": "Medium",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 4) * 1px), calc(var(--wp--custom--spacing-increment) * 4 * 1vw))",
                    "slug": "50"
                },
                {
                    "name": "Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 5) * 1px), calc(var(--wp--custom--spacing-increment) * 5 * 1vw))",
                    "slug": "60"
                },
                {
                    "name": "Extra Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 6) * 1px), calc(var(--wp--custom--spacing-increment) * 6 * 1vw))",
                    "slug": "70"
                },
                {
                    "name": "2X Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 7) * 1px), calc(var(--wp--custom--spacing-increment) * 7 * 1vw))",
                    "slug": "80"
                }
            ],
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFace": [
                        {
                            "fontFamily": "Fraunces",
                            "fontStretch": "normal",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [
                                "https://fonts.gstatic.com/s/fraunces/v32/6NUh8FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk.woff2"
                            ]
                        }
                    ],
                    "fontFamily": "\"Fraunces\", Georgia, serif",
                    "name": "Fraunces",
                    "slug": "fraunces"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontStretch": "normal",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [
                                "https://fonts.gstatic.com/s/inter/v18/UcCo3FwrK3iLTcvneQg7Ca725JhhKnNqk4j1ebLhAm8SrXTc2dFufDYqpw.woff2"
                            ]
                        }
                    ],
                    "fontFamily": "\"Inter\", Arial, sans-serif",
                    "name": "Inter",
                    "slug": "inter"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "14px",
                    "slug": "small"
                },
                {
                    "name": "Medium",
                    "size": "17px",
                    "slug": "medium"
                },
                {
                    "name": "Large",
                    "size": "26px",
                    "slug": "large"
                },
                {
                    "name": "Extra Large",
                    "size": "44px",
                    "slug": "x-large",
                    "fluid": {
                        "min": "32px",
                        "max": "44px"
                    }
                },
                {
                    "name": "2X Large",
                    "size": "72px",
                    "slug": "xx-large",
                    "fluid": {
                        "min": "44px",
                        "max": "72px"
                    }
                },
                {
                    "name": "3X Large",
                    "size": "120px",
                    "slug": "xxx-large",
                    "fluid": {
                        "min": "60px",
                        "max": "120px"
                    }
                }
            ],
            "writingMode": true
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--inter)",
            "fontSize": "17px",
            "fontWeight": "400",
            "lineHeight": "1.65"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--30)",
            "padding": {
                "left": "var(--wp--preset--spacing--40)",
                "right": "var(--wp--preset--spacing--40)"
            }
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontWeight": "650",
                    "lineHeight": "1.08",
                    "letterSpacing": "-0.01em"
                }
            },
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--xxx-large)",
                    "fontWeight": "700",
                    "lineHeight": "0.98",
                    "letterSpacing": "-0.025em"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "650",
                    "lineHeight": "1.04",
                    "letterSpacing": "-0.018em"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "600",
                    "lineHeight": "1.1",
                    "letterSpacing": "-0.012em"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600",
                    "lineHeight": "1.15"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "13px",
                    "fontWeight": "600",
                    "lineHeight": "1.3",
                    "letterSpacing": "0.14em",
                    "textTransform": "uppercase"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "12px",
                    "fontWeight": "600",
                    "letterSpacing": "0.18em",
                    "textTransform": "uppercase"
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--ferment-ink)",
                    "text": "var(--wp--preset--color--background)"
                },
                "border": {
                    "radius": "6px",
                    "width": "1px",
                    "style": "solid",
                    "color": "var(--wp--preset--color--ferment-ink)"
                },
                "spacing": {
                    "padding": {
                        "top": "16px",
                        "right": "28px",
                        "bottom": "16px",
                        "left": "28px"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "14px",
                    "fontWeight": "550",
                    "letterSpacing": "0.02em",
                    "lineHeight": "1"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--herb)",
                        "text": "var(--wp--preset--color--background)"
                    },
                    "border": {
                        "color": "var(--wp--preset--color--herb)"
                    }
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--herb)"
                },
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "underline"
                    }
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "22px",
                    "fontWeight": "650",
                    "letterSpacing": "-0.01em",
                    "lineHeight": "1"
                }
            },
            "core/site-tagline": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "12px",
                    "fontWeight": "500",
                    "letterSpacing": "0.16em",
                    "textTransform": "uppercase"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "13px",
                    "fontWeight": "500",
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase",
                    "lineHeight": "1.3"
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "12px"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": {
                        "left": "var(--wp--preset--spacing--40)",
                        "top": "var(--wp--preset--spacing--40)"
                    }
                }
            },
            "core/separator": {
                "border": {
                    "top": {
                        "width": "1px"
                    }
                },
                "color": {
                    "text": "var(--wp--preset--color--sage-edge)"
                }
            },
            "core/quote": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontStyle": "italic",
                    "fontWeight": "500",
                    "lineHeight": "1.3"
                },
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--herb)",
                        "width": "2px"
                    }
                }
            },
            "woocommerce/product-collection": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--40)"
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
}
