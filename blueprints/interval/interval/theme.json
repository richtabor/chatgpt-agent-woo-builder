{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                {
                    "color": "#F2EEE6",
                    "name": "Bone",
                    "slug": "bone"
                },
                {
                    "color": "#101214",
                    "name": "Ink",
                    "slug": "ink"
                },
                {
                    "color": "#E85B2B",
                    "name": "Signal",
                    "slug": "signal"
                },
                {
                    "color": "#DDE6E8",
                    "name": "Mist",
                    "slug": "mist"
                },
                {
                    "color": "#AAB6BA",
                    "name": "Mist Line",
                    "slug": "mist-line"
                },
                {
                    "color": "#2A2E32",
                    "name": "Asphalt Line",
                    "slug": "asphalt-line"
                }
            ]
        },
        "custom": {
            "spacing-increment": "2.5",
            "spacing-unit": "8",
            "input-background": "#DDE6E8"
        },
        "layout": {
            "contentSize": "680px",
            "wideSize": "1440px"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingScale": {
                "steps": 1
            },
            "spacingSizes": [
                {
                    "name": "2X-Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 1) * 1px), calc(var(--wp--custom--spacing-increment) * 1 * 2vw))",
                    "slug": "20"
                },
                {
                    "name": "X-Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 2) * 1px), calc(var(--wp--custom--spacing-increment) * 2 * 1vw))",
                    "slug": "30"
                },
                {
                    "name": "Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 3) * 1px), calc(var(--wp--custom--spacing-increment) * 3 * 1vw))",
                    "slug": "40"
                },
                {
                    "name": "Medium",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 4) * 1px), calc(var(--wp--custom--spacing-increment) * 4 * 1vw))",
                    "slug": "50"
                },
                {
                    "name": "Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 5) * 1px), calc(var(--wp--custom--spacing-increment) * 5 * 1vw))",
                    "slug": "60"
                },
                {
                    "name": "Extra Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 6) * 1px), calc(var(--wp--custom--spacing-increment) * 6 * 1vw))",
                    "slug": "70"
                },
                {
                    "name": "2X Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 7) * 1px), calc(var(--wp--custom--spacing-increment) * 7 * 1vw))",
                    "slug": "80"
                }
            ],
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "Archivo, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
                    "name": "Archivo",
                    "slug": "archivo"
                },
                {
                    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
                    "name": "Inter",
                    "slug": "inter"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "13px",
                    "slug": "small"
                },
                {
                    "name": "Medium",
                    "size": "17px",
                    "slug": "medium"
                },
                {
                    "name": "Large",
                    "size": "32px",
                    "slug": "large",
                    "fluid": {
                        "min": "26px",
                        "max": "32px"
                    }
                },
                {
                    "name": "Extra Large",
                    "size": "56px",
                    "slug": "x-large",
                    "fluid": {
                        "min": "40px",
                        "max": "56px"
                    }
                },
                {
                    "name": "2X Large",
                    "size": "104px",
                    "slug": "xx-large",
                    "fluid": {
                        "min": "56px",
                        "max": "104px"
                    }
                },
                {
                    "name": "3X Large",
                    "size": "192px",
                    "slug": "xxx-large",
                    "fluid": {
                        "min": "72px",
                        "max": "192px"
                    }
                }
            ],
            "writingMode": true
        },
        "blocks": {
            "core/heading": {
                "color": {
                    "background": false
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--bone)",
            "text": "var(--wp--preset--color--ink)"
        },
        "css": ".no-underline a { text-decoration: none; } .uppercase { text-transform: uppercase; letter-spacing: 0.04em; } .tight-track { letter-spacing: -0.02em; } .tracking-wide { letter-spacing: 0.16em; } .has-ink-background-color a { color: var(--wp--preset--color--bone); } .pace-chip { display: inline-block; padding: 4px 10px; border: 1px solid currentColor; border-radius: 9999px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; } .hairline-top { border-top: 1px solid var(--wp--preset--color--mist-line); } .hairline-bottom { border-bottom: 1px solid var(--wp--preset--color--mist-line); } .product-card { border: 1px solid var(--wp--preset--color--mist-line); transition: transform 0.15s ease, border-color 0.15s ease; } .product-card:hover { border-color: var(--wp--preset--color--ink); }",
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--20)",
            "padding": {
                "left": "var(--wp--preset--spacing--40)",
                "right": "var(--wp--preset--spacing--40)"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--inter)",
            "fontSize": "16px",
            "fontWeight": "400",
            "lineHeight": "1.55"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "800",
                    "lineHeight": "0.92",
                    "letterSpacing": "-0.03em"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "750",
                    "lineHeight": "0.96",
                    "letterSpacing": "-0.02em"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "700",
                    "lineHeight": "1.05",
                    "letterSpacing": "-0.01em"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "20px",
                    "fontWeight": "700",
                    "lineHeight": "1.15"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "700",
                    "lineHeight": "1.25"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "11px",
                    "fontWeight": "700",
                    "lineHeight": "1.2",
                    "letterSpacing": "0.16em",
                    "textTransform": "uppercase"
                }
            },
            "heading": {
                "css": "&.has-background { padding: 0; }",
                "color": {
                    "text": "var(--wp--preset--color--ink)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontWeight": "700"
                }
            },
            "button": {
                ":hover": {
                    "color": {
                        "background": "color-mix(in srgb, var(--wp--preset--color--signal) 88%, #000)"
                    }
                },
                "border": {
                    "radius": "9999px"
                },
                "color": {
                    "background": "var(--wp--preset--color--signal)",
                    "text": "var(--wp--preset--color--ink)"
                },
                "spacing": {
                    "padding": {
                        "top": "14px",
                        "bottom": "14px",
                        "left": "28px",
                        "right": "28px"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "13px",
                    "fontWeight": "700",
                    "letterSpacing": "0.12em",
                    "textTransform": "uppercase"
                }
            },
            "link": {
                "color": {
                    "text": "currentColor"
                },
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "underline"
                    }
                }
            },
            "caption": {
                "spacing": {
                    "padding": {
                        "top": "8px"
                    }
                },
                "typography": {
                    "fontWeight": "500",
                    "fontSize": "12px",
                    "letterSpacing": "0.12em",
                    "textTransform": "uppercase"
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "20px",
                    "fontWeight": "800",
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase",
                    "lineHeight": "1"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontSize": "12px",
                    "fontWeight": "650",
                    "letterSpacing": "0.14em",
                    "textTransform": "uppercase",
                    "lineHeight": "1.3"
                }
            },
            "core/post-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--archivo)",
                    "fontWeight": "700"
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "10px",
                    "margin": {
                        "top": "calc( var(--wp--style--block-gap) * 1.5)"
                    }
                }
            },
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "width": "1.5px",
                            "color": "currentColor"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "currentColor"
                        },
                        "spacing": {
                            "padding": {
                                "top": "12.5px",
                                "bottom": "12.5px",
                                "left": "26px",
                                "right": "26px"
                            }
                        }
                    }
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": {
                        "left": "var(--wp--preset--spacing--40)",
                        "top": "var(--wp--preset--spacing--30)"
                    }
                }
            },
            "core/separator": {
                "border": {
                    "top": {
                        "width": "1px"
                    }
                },
                "color": {
                    "text": "var(--wp--preset--color--mist-line)"
                }
            },
            "core/post-content": {
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--20)",
                        "bottom": "var(--wp--preset--spacing--60)"
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "header",
            "name": "utility-bar",
            "title": "Utility Bar"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
}
