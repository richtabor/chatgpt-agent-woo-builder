{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Pearl",
    "settings": {
        "color": {
            "palette": [
                {
                    "color": "#EFF0F2",
                    "name": "Color 1",
                    "slug": "theme-1"
                },
                {
                    "color": "#101D38",
                    "name": "Color 2",
                    "slug": "theme-2"
                },
                {
                    "color": "#184690",
                    "name": "Color 3",
                    "slug": "theme-3"
                },
                {
                    "color": "#334b4a",
                    "name": "Color 4",
                    "slug": "theme-4"
                },
                {
                    "color": "#060A14",
                    "name": "Color 5",
                    "slug": "theme-5"
                },
                {
                    "color": "#FFFFFF",
                    "name": "Color 6",
                    "slug": "theme-6"
                }
            ],
            "duotone": [
                {
                    "colors": [
                        "#101D38",
                        "#EFF0F2"
                    ],
                    "slug": "duotone-1",
                    "name": "Duotone 1"
                },
                {
                    "colors": [
                        "#334b4a",
                        "#FFFFFF"
                    ],
                    "slug": "duotone-2",
                    "name": "Duotone 2"
                }
            ],
            "gradients": [
                {
                    "slug": "gradient-text-transparent",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-2) -50%, transparent 50%)",
                    "name": "Text to Transparent"
                },
                {
                    "slug": "gradient-1-2",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-1) 0%, var(--wp--preset--color--theme-2) 100%)",
                    "name": "Gradient 1"
                },
                {
                    "slug": "gradient-1-3",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-1) 0%, var(--wp--preset--color--theme-3) 100%)",
                    "name": "Gradient 2"
                },
                {
                    "slug": "gradient-1-4",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-1) 0%, var(--wp--preset--color--theme-4) 100%)",
                    "name": "Gradient 3"
                },
                {
                    "slug": "gradient-1-5",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-1) 0%, var(--wp--preset--color--theme-5) 100%)",
                    "name": "Gradient 4"
                },
                {
                    "slug": "gradient-1-6",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-1) 0%, var(--wp--preset--color--theme-6) 100%)",
                    "name": "Gradient 5"
                },
                {
                    "slug": "gradient-2-3",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-2) 0%, var(--wp--preset--color--theme-3) 100%)",
                    "name": "Gradient 6"
                },
                {
                    "slug": "gradient-2-4",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-2) 0%, var(--wp--preset--color--theme-4) 100%)",
                    "name": "Gradient 7"
                },
                {
                    "slug": "gradient-2-5",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-2) 0%, var(--wp--preset--color--theme-5) 100%)",
                    "name": "Gradient 8"
                },
                {
                    "slug": "gradient-2-6",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-2) 0%, var(--wp--preset--color--theme-6) 100%)",
                    "name": "Gradient 9"
                },
                {
                    "slug": "gradient-3-4",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-3) 0%, var(--wp--preset--color--theme-4) 100%)",
                    "name": "Gradient 10"
                },
                {
                    "slug": "gradient-3-5",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-3) 0%, var(--wp--preset--color--theme-5) 100%)",
                    "name": "Gradient 11"
                },
                {
                    "slug": "gradient-3-6",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-3) 0%, var(--wp--preset--color--theme-6) 100%)",
                    "name": "Gradient 12"
                },
                {
                    "slug": "gradient-4-5",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-4) 0%, var(--wp--preset--color--theme-5) 100%)",
                    "name": "Gradient 13"
                },
                {
                    "slug": "gradient-4-6",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-4) 0%, var(--wp--preset--color--theme-6) 100%)",
                    "name": "Gradient 14"
                },
                {
                    "slug": "gradient-5-6",
                    "gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-5) 0%, var(--wp--preset--color--theme-6) 100%)",
                    "name": "Gradient 15"
                }
            ]
        },
        "custom": {
            "input-background": "oklch(from var(--wp--preset--color--theme-1) calc(l * 1.05) calc(c * 1.075) h)"
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFace": [
                        {
                            "fontFamily": "Ibarra Real Nova",
                            "fontStretch": "normal",
                            "fontStyle": "normal",
                            "fontWeight": "100 800",
                            "src": [
                                "file:./assets/fonts/ibarra-real-nova/IbarraRealNova-VariableFont_wght.woff2"
                            ]
                        }
                    ],
                    "fontFamily": "\"Ibarra Real Nova\", serif",
                    "name": "Ibarra Real Nova",
                    "slug": "ibarra-real-nova"
                },
                {
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontStretch": "normal",
                            "fontStyle": "normal",
                            "fontWeight": "100 800",
                            "src": [
                                "file:./assets/fonts/inter/InterVariable.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Inter",
                            "fontStretch": "normal",
                            "fontStyle": "italic",
                            "fontWeight": "100 800",
                            "src": [
                                "file:./assets/fonts/inter/InterVariable-Italic.woff2"
                            ]
                        }
                    ],
                    "fontFamily": "\"Inter\", sans-serif",
                    "name": "Inter",
                    "slug": "inter"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "19px",
                    "slug": "small",
                    "fluid": {
                        "min": "18px",
                        "max": "19px"
                    }
                },
                {
                    "name": "Medium",
                    "size": "20px",
                    "slug": "medium",
                    "fluid": {
                        "min": "18px",
                        "max": "20px"
                    }
                },
                {
                    "name": "Large",
                    "size": "26px",
                    "slug": "large",
                    "fluid": {
                        "min": "18px",
                        "max": "26px"
                    }
                },
                {
                    "name": "Extra Large",
                    "size": "64px",
                    "slug": "x-large",
                    "fluid": {
                        "min": "32px",
                        "max": "64px"
                    }
                },
                {
                    "name": "2X Large",
                    "size": "84px",
                    "slug": "xx-large",
                    "fluid": {
                        "min": "34px",
                        "max": "84px"
                    }
                },
                {
                    "name": "3X Large",
                    "size": "120px",
                    "slug": "xxx-large",
                    "fluid": {
                        "min": "36px",
                        "max": "120px"
                    }
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--theme-1)",
            "text": "var(--wp--preset--color--theme-2)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--ibarra-real-nova)",
            "fontSize": "var(--wp--preset--font-size--small)",
            "fontStyle": "normal",
            "fontWeight": "400",
            "lineHeight": "1.55em"
        },
        "blocks": {
            "core/separator": {
                "color": {
                    "text": "color-mix(in srgb, currentColor 25%, transparent)"
                }
            },
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "13px",
                    "fontWeight": "600",
                    "textTransform": "uppercase",
                    "letterSpacing": "3px",
                    "lineHeight": {
                        "ref": "styles.blocks.core/navigation.typography.lineHeight"
                    }
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "13px",
                    "fontWeight": "500",
                    "textTransform": "uppercase",
                    "letterSpacing": "3px",
                    "lineHeight": "1.4"
                }
            },
            "core/site-tagline": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "12px",
                    "fontWeight": "500",
                    "textTransform": "uppercase",
                    "letterSpacing": "3px"
                }
            }
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--theme-3)",
                    "text": "var(--wp--preset--color--theme-6)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "13px",
                    "fontWeight": "500",
                    "textTransform": "uppercase",
                    "letterSpacing": "3px"
                },
                ":hover": {
                    "color": {
                        "background": "color-mix(in srgb, var(--wp--preset--color--theme-3) 85%, #000)",
                        "text": "var(--wp--preset--color--theme-6)"
                    }
                }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--ibarra-real-nova)",
                    "fontWeight": "100",
                    "lineHeight": "1",
                    "letterSpacing": "-0.01em"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "lineHeight": "0.9"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "textTransform": "uppercase",
                    "letterSpacing": "3px",
                    "fontWeight": "500"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "textTransform": "uppercase",
                    "letterSpacing": "3px",
                    "fontWeight": "500"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "500",
                    "letterSpacing": "2px"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "500"
                }
            }
        },
        "variations": {
            "section-1": {
                "color": {
                    "background": "var(--wp--preset--color--theme-3)",
                    "text": "var(--wp--preset--color--theme-1)"
                },
                "blocks": {
                    "core/separator": {
                        "color": {
                            "text": "color-mix(in srgb, currentColor 25%, transparent)"
                        }
                    }
                },
                "elements": {
                    "button": {
                        "color": {
                            "background": "var(--wp--preset--color--theme-1)",
                            "text": "var(--wp--preset--color--theme-3)"
                        },
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--theme-6)",
                                "text": "var(--wp--preset--color--theme-3)"
                            }
                        }
                    },
                    "heading": {
                        "color": {
                            "text": "var(--wp--preset--color--theme-1)"
                        }
                    }
                }
            },
            "section-2": {
                "color": {
                    "background": "var(--wp--preset--color--theme-4)",
                    "text": "var(--wp--preset--color--theme-1)"
                },
                "blocks": {
                    "core/separator": {
                        "color": {
                            "text": "color-mix(in srgb, currentColor 25%, transparent)"
                        }
                    }
                },
                "elements": {
                    "button": {
                        "color": {
                            "background": "var(--wp--preset--color--theme-1)",
                            "text": "var(--wp--preset--color--theme-4)"
                        },
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--theme-6)",
                                "text": "var(--wp--preset--color--theme-4)"
                            }
                        }
                    },
                    "heading": {
                        "color": {
                            "text": "var(--wp--preset--color--theme-6)"
                        }
                    }
                }
            },
            "section-3": {
                "color": {
                    "background": "var(--wp--preset--color--theme-5)",
                    "text": "var(--wp--preset--color--theme-1)"
                },
                "blocks": {
                    "core/post-date": {
                        "color": {
                            "text": "color-mix(in srgb, currentColor 65%, transparent)"
                        }
                    }
                },
                "elements": {
                    "button": {
                        "color": {
                            "background": "var(--wp--preset--color--theme-1)",
                            "text": "var(--wp--preset--color--theme-5)"
                        },
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--theme-6)",
                                "text": "var(--wp--preset--color--theme-5)"
                            }
                        }
                    },
                    "heading": {
                        "color": {
                            "text": "var(--wp--preset--color--theme-6)"
                        }
                    }
                }
            }
        }
    }
}
