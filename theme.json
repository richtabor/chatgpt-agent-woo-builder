{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                {
                    "color": "#F5F0E6",
                    "name": "Background",
                    "slug": "background"
                },
                {
                    "color": "#1E1A17",
                    "name": "Foreground",
                    "slug": "foreground"
                },
                {
                    "color": "#375145",
                    "name": "Herb",
                    "slug": "herb"
                },
                {
                    "color": "#DCE3D4",
                    "name": "Ferment",
                    "slug": "ferment"
                },
                {
                    "color": "#1F241D",
                    "name": "Ferment Ink",
                    "slug": "ferment-ink"
                },
                {
                    "color": "#A4AF9C",
                    "name": "Ferment Border",
                    "slug": "ferment-border"
                },
                {
                    "color": "#262B24",
                    "name": "Cellar",
                    "slug": "cellar"
                },
                {
                    "color": "#F9F6EF",
                    "name": "Paper",
                    "slug": "paper"
                },
                {
                    "color": "#8D927F",
                    "name": "Cellar Edge",
                    "slug": "cellar-edge"
                }
            ]
        },
        "custom": {
            "spacing-increment": "2.5",
            "spacing-unit": "14"
        },
        "layout": {
            "contentSize": "680px",
            "wideSize": "1320px"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingScale": {
                "steps": 1
            },
            "spacingSizes": [
                {
                    "name": "2X-Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 1) * 1px), calc(var(--wp--custom--spacing-increment) * 1 * 2vw))",
                    "slug": "20"
                },
                {
                    "name": "X-Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 2) * 1px), calc(var(--wp--custom--spacing-increment) * 2 * 1vw))",
                    "slug": "30"
                },
                {
                    "name": "Small",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 3) * 1px), calc(var(--wp--custom--spacing-increment) * 3 * 1vw))",
                    "slug": "40"
                },
                {
                    "name": "Medium",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 4) * 1px), calc(var(--wp--custom--spacing-increment) * 4 * 1vw))",
                    "slug": "50"
                },
                {
                    "name": "Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 5) * 1px), calc(var(--wp--custom--spacing-increment) * 5 * 1vw))",
                    "slug": "60"
                },
                {
                    "name": "Extra Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 6) * 1px), calc(var(--wp--custom--spacing-increment) * 6 * 1vw))",
                    "slug": "70"
                },
                {
                    "name": "2X Large",
                    "size": "min(calc(var(--wp--custom--spacing-unit) * (var(--wp--custom--spacing-increment) * 7) * 1px), calc(var(--wp--custom--spacing-increment) * 7 * 1vw))",
                    "slug": "80"
                }
            ],
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif",
                    "name": "Fraunces",
                    "slug": "fraunces"
                },
                {
                    "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
                    "name": "Inter",
                    "slug": "inter"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "14px",
                    "slug": "small"
                },
                {
                    "name": "Medium",
                    "size": "17px",
                    "slug": "medium"
                },
                {
                    "name": "Large",
                    "size": "24px",
                    "slug": "large",
                    "fluid": {
                        "min": "20px",
                        "max": "26px"
                    }
                },
                {
                    "name": "Extra Large",
                    "size": "40px",
                    "slug": "x-large",
                    "fluid": {
                        "min": "30px",
                        "max": "44px"
                    }
                },
                {
                    "name": "2X Large",
                    "size": "64px",
                    "slug": "xx-large",
                    "fluid": {
                        "min": "40px",
                        "max": "72px"
                    }
                },
                {
                    "name": "3X Large",
                    "size": "96px",
                    "slug": "xxx-large",
                    "fluid": {
                        "min": "56px",
                        "max": "112px"
                    }
                }
            ],
            "writingMode": true
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--foreground)"
        },
        "css": "@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap'); body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;} .is-style-ferment{background-color:var(--wp--preset--color--ferment);color:var(--wp--preset--color--ferment-ink);} .is-style-cellar{background-color:var(--wp--preset--color--cellar);color:var(--wp--preset--color--background);} .is-style-paper{background-color:var(--wp--preset--color--paper);color:var(--wp--preset--color--foreground);} .is-style-cellar a{color:var(--wp--preset--color--background);} .is-style-cellar h1, .is-style-cellar h2, .is-style-cellar h3, .is-style-cellar h4, .is-style-cellar h5, .is-style-cellar h6{color:var(--wp--preset--color--background);} .is-style-cellar .wp-block-button__link{background-color:var(--wp--preset--color--background)!important;color:var(--wp--preset--color--ferment-ink)!important;} .is-style-ferment h1, .is-style-ferment h2, .is-style-ferment h3, .is-style-ferment h4, .is-style-ferment h5, .is-style-ferment h6{color:var(--wp--preset--color--ferment-ink);}",
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--30)",
            "padding": {
                "left": "var(--wp--preset--spacing--40)",
                "right": "var(--wp--preset--spacing--40)"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--inter)",
            "fontSize": "17px",
            "fontWeight": "400",
            "lineHeight": "1.6"
        },
        "elements": {
            "button": {
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--herb)",
                        "text": "var(--wp--preset--color--background)"
                    }
                },
                "border": {
                    "radius": "6px"
                },
                "color": {
                    "background": "var(--wp--preset--color--ferment-ink)",
                    "text": "var(--wp--preset--color--background)"
                },
                "spacing": {
                    "padding": {
                        "top": "16px",
                        "bottom": "16px",
                        "left": "26px",
                        "right": "26px"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "15px",
                    "fontWeight": "500",
                    "letterSpacing": "0.01em"
                }
            },
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--xxx-large)",
                    "fontWeight": "600",
                    "lineHeight": "1.02",
                    "letterSpacing": "-0.02em"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "600",
                    "lineHeight": "1.05",
                    "letterSpacing": "-0.015em"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "600",
                    "lineHeight": "1.1",
                    "letterSpacing": "-0.01em"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600",
                    "lineHeight": "1.2"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "600",
                    "letterSpacing": "0.04em",
                    "textTransform": "uppercase"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "600",
                    "letterSpacing": "0.08em",
                    "textTransform": "uppercase"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--foreground)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--herb)"
                },
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "underline"
                    }
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--foreground)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontSize": "26px",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em",
                    "lineHeight": "1"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "14px",
                    "fontWeight": "500",
                    "letterSpacing": "0.02em"
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "12px"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": {
                        "left": "var(--wp--preset--spacing--40)",
                        "top": "var(--wp--preset--spacing--40)"
                    }
                }
            },
            "core/separator": {
                "border": {
                    "top": {
                        "width": "1px"
                    }
                },
                "color": {
                    "text": "var(--wp--preset--color--cellar-edge)"
                }
            },
            "core/heading": {
                "color": {
                    "background": false
                }
            },
            "core/quote": {
                "border": {
                    "left": {
                        "width": "2px",
                        "color": "var(--wp--preset--color--herb)",
                        "style": "solid"
                    }
                },
                "spacing": {
                    "padding": {
                        "left": "var(--wp--preset--spacing--30)"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--fraunces)",
                    "fontStyle": "italic",
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "core/group": {
                "variations": {
                    "ferment": {
                        "color": {
                            "background": "var(--wp--preset--color--ferment)",
                            "text": "var(--wp--preset--color--ferment-ink)"
                        }
                    },
                    "cellar": {
                        "color": {
                            "background": "var(--wp--preset--color--cellar)",
                            "text": "var(--wp--preset--color--background)"
                        }
                    },
                    "paper": {
                        "color": {
                            "background": "var(--wp--preset--color--paper)",
                            "text": "var(--wp--preset--color--foreground)"
                        }
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
}
